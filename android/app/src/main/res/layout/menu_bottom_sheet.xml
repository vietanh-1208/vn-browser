<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="#334155" />

        <!-- Top Quick Action Row (4 clean icons without Bookmarks) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/bsNewTab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="＋"
                    android:textSize="19sp"
                    android:textColor="#34D399"
                    android:background="@drawable/bg_bottom_plus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tab mới"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bsIncognito"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🕵️"
                    android:textSize="17sp"
                    android:background="@drawable/bg_bottom_plus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ẩn danh"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bsTranslate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🌐"
                    android:textSize="18sp"
                    android:background="@drawable/bg_bottom_plus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dịch"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bsReload"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="↻"
                    android:textSize="19sp"
                    android:textColor="#38BDF8"
                    android:background="@drawable/bg_bottom_plus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tải lại"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="6dp" />

        <TextView android:id="@+id/bsHistory" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🕒  Lịch sử duyệt web" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsDownloads" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="⬇  Tệp đã tải xuống" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsAutofill" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🔑  Tự điền tài khoản trang này" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsPasswords" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🛡️  Quản lý mật khẩu (Khoá máy)" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView android:id="@+id/bsFind" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🔎  Tìm trong trang" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsPip" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="📺  Mở video nổi (PiP)" android:textColor="#38BDF8" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsBgAudio" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🎵  Phát nhạc nền khi tắt màn: Đang bật" android:textColor="#34D399" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsReader" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="📖  Chế độ đọc sách" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsDesktop" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🖥️  Trang web cho máy tính: Tắt" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsAdblock" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🛡️  Chặn quảng cáo: Đang bật" android:textColor="#34D399" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsDark" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="🌙  Nền tối trang web: Đang bật" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/bsSettings" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="⚙️  Cài đặt VN Surf" android:textColor="#F8FAFC" android:textSize="14sp" android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</ScrollView>
