<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabCardRoot"
    android:layout_width="match_parent"
    android:layout_height="216dp"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/bg_tab_card_normal">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tabCardIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="V"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_icon" />

        <TextView
            android:id="@+id/tabCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:text="Tab mới"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tabCardClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Thumbnail Preview Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F172A">

        <ImageView
            android:id="@+id/tabCardPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/tabCardFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:id="@+id/tabCardDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Trang chủ VN Surf"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tabCardBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="● Đang mở"
            android:textColor="#34D399"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_badge" />
    </FrameLayout>

</LinearLayout>
