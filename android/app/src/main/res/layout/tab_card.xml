<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabCardRoot"
    android:layout_width="match_parent"
    android:layout_height="156dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_tab_card_normal">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabCardIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="V"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_icon" />

        <TextView
            android:id="@+id/tabCardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="6dp"
            android:text="Tab mới"
            android:textColor="#F8FAFC"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tabCardClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview Body -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tabCardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="● Đang mở"
        android:textColor="#34D399"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_pill_badge"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tabCardDomain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trang chủ VN Surf"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
